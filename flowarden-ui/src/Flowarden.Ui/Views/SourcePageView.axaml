<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="using:Flowarden.Ui.Views.Components"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.SourcePageView"
             x:DataType="vm:SourcePageViewModel">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
    <Border Classes="glass-panel">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
        <Button Grid.Column="0"
                Classes="mode-button"
                Command="{Binding RefreshPreviewCommand}"
                Content="Refresh Preview" />
        <Button Grid.Column="1"
                Classes="tools-button"
                Command="{Binding ImportOfflineCommand}"
                Content="Import Offline" />
        <StackPanel Grid.Column="2"
                    VerticalAlignment="Center"
                    Spacing="2">
          <SelectableTextBlock FontWeight="SemiBold"
                               Text="{Binding PreviewStatusLabel}" />
          <SelectableTextBlock Classes="muted-text"
                               Text="{Binding PreviewStatusDetail}" />
        </StackPanel>
        <SelectableTextBlock Grid.Column="3"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Classes="muted-text"
                             Text="{Binding LastPreviewLabel}" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="360,*" ColumnSpacing="16">
      <components:SourceDeviceListView DataContext="{Binding}" />
      <components:SourcePreviewWorkbenchView Grid.Column="1" DataContext="{Binding}" />
    </Grid>

    <Border Grid.Row="2" Classes="glass-panel">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
        <StackPanel>
          <TextBlock Classes="section-title" Text="Formal Capture Boundary" />
          <SelectableTextBlock Classes="muted-text" Text="{Binding FormalCaptureSummary}" />
          <Border Classes="status-pill"
                  HorizontalAlignment="Left"
                  Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock FontWeight="SemiBold" Text="State" />
              <SelectableTextBlock Classes="muted-text" Text="{Binding CaptureStateLabel}" />
            </StackPanel>
          </Border>
          <SelectableTextBlock Margin="0,8,0,0"
                               Classes="muted-text"
                               Text="{Binding StatusMessage}" />
        </StackPanel>

        <Button Grid.Column="1"
                Classes="mode-button"
                IsEnabled="{Binding CanStartFormalCapture}"
                Content="Start In Live"
                Command="{Binding StartFormalCaptureCommand}" />

        <Button Grid.Column="2"
                Classes="tools-button"
                IsEnabled="{Binding CanStopFormalCapture}"
                Content="Stop"
                Command="{Binding StopFormalCaptureCommand}" />

        <Button Grid.Column="3"
                Classes="tools-button"
                Content="Load Offline Pcap"
                Command="{Binding ImportOfflineCommand}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
