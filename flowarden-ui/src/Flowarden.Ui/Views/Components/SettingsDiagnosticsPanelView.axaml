<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.Components.SettingsDiagnosticsPanelView"
             x:DataType="vm:SettingsPageViewModel">
  <Border Classes="tfc-panel" Padding="20,18">
    <Grid RowDefinitions="Auto,*" RowSpacing="14">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="section-title" Text="Diagnostics" />
        <Button Grid.Column="1" Classes="mode-button" Height="32" Padding="14,5" Content="Export" />
      </Grid>

      <Border Grid.Row="1" Classes="tfc-panel-low" Padding="12">
        <StackPanel Spacing="6">
          <ItemsControl ItemsSource="{Binding Diagnostics}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="82,*" ColumnSpacing="10" Margin="0,0,0,6">
                  <TextBlock Classes="tfc-data" FontSize="12" Foreground="{StaticResource TfcWarningBrush}" Text="{Binding Reason, StringFormat=[{0}]}" />
                  <TextBlock Grid.Column="1" Classes="tfc-data" FontSize="12" Text="{Binding Message}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid ColumnDefinitions="82,*" ColumnSpacing="10">
            <TextBlock Classes="tfc-data" FontSize="12" Foreground="{StaticResource TfcGoodBrush}" Text="[INFO]" />
            <TextBlock Grid.Column="1" Classes="tfc-data" FontSize="12" Text="UI diagnostics panel ready." />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
