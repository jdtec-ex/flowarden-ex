<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.Components.TopConnectionsView"
             x:DataType="vm:OverviewPageViewModel"
             x:Name="Root">
  <Border Classes="tfc-panel" ClipToBounds="True">
    <Grid RowDefinitions="32,*">
      <Border Classes="tfc-panel-header" Padding="16,0">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="Top Connections" />
          <TextBlock Grid.Column="1" Classes="tfc-label" VerticalAlignment="Center" Text="VOLUME" />
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <TextBlock Classes="muted-text" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Text="No connection data yet" IsVisible="{Binding HasNoTopConnectionRows}" />
        <ItemsControl Margin="10,8" ItemsSource="{Binding TopConnectionRows}" IsVisible="{Binding HasTopConnectionRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:OverviewConnectionRowViewModel">
              <Button Classes="ranking-row"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Command="{Binding #Root.((vm:OverviewPageViewModel)DataContext).PivotRankingCommand}"
                      CommandParameter="{Binding}"
                      ToolTip.Tip="{Binding PivotTooltip}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Height="28">
                  <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                    <TextBlock Classes="tfc-data"
                               Foreground="{StaticResource TfcTextBrush}"
                               Text="{Binding SourceAddress}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Classes="muted-text" Text="->" />
                    <TextBlock Grid.Column="2"
                               Classes="tfc-data"
                               Foreground="{StaticResource TfcTextBrush}"
                               Text="{Binding DestinationAddress}"
                               TextTrimming="CharacterEllipsis" />
                  </Grid>
                  <StackPanel Grid.Column="1"
                              Orientation="Horizontal"
                              Spacing="6"
                              VerticalAlignment="Center"
                              MaxWidth="120">
                    <Border Width="16"
                            Height="16"
                            CornerRadius="3"
                            ClipToBounds="True"
                            Background="{StaticResource TfcPanelBrush}"
                            BorderBrush="{StaticResource TfcBorderBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                      <Panel>
                        <Image Source="{Binding ProcessIcon}"
                               Stretch="Uniform"
                               IsVisible="{Binding HasProcessIcon}" />
                        <TextBlock FontSize="9"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{Binding ProcessMonogram}"
                                   Foreground="{Binding ProcessMonogramBrush}"
                                   IsVisible="{Binding ShowProcessMonogram}" />
                      </Panel>
                    </Border>
                    <TextBlock Classes="muted-text"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Text="{Binding ProcessLabel}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding ProcessLabel}" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Classes="tfc-data" Foreground="{StaticResource TfcMutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding VolumeLabel}" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Grid>
  </Border>
</UserControl>
