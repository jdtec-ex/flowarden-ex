<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.Components.TopConnectionsView"
             x:DataType="vm:OverviewPageViewModel">
  <Border Classes="tfc-panel" ClipToBounds="True">
    <Grid RowDefinitions="32,*">
      <Border Classes="tfc-panel-header" Padding="16,0">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="Top Connections" />
          <TextBlock Grid.Column="1" Classes="tfc-label" VerticalAlignment="Center" Text="VOLUME" />
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <TextBlock Classes="muted-text" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Text="No connection data yet" IsVisible="{Binding HasNoTopConnectionRows}" />
        <ItemsControl Margin="10,8" ItemsSource="{Binding TopConnectionRows}" IsVisible="{Binding HasTopConnectionRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:OverviewConnectionRowViewModel">
              <Border Height="32" BorderBrush="{StaticResource TfcBorderBrush}" BorderThickness="0,0,0,1" Padding="2,0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                  <TextBlock Classes="tfc-data"
                             Foreground="{StaticResource TfcTextBrush}"
                             Text="{Binding SourceAddress}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Classes="muted-text" Text="->" />
                  <TextBlock Grid.Column="2"
                             Classes="tfc-data"
                             Foreground="{StaticResource TfcTextBrush}"
                             Text="{Binding DestinationAddress}"
                             TextTrimming="CharacterEllipsis" />
                </Grid>
                  <TextBlock Grid.Column="1" Classes="tfc-data" Foreground="{StaticResource TfcMutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding VolumeLabel}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Grid>
  </Border>
</UserControl>
