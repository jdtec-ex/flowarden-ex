<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shapes="using:Avalonia.Controls.Shapes"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.Components.HeroTrafficChartView"
             x:DataType="vm:OverviewPageViewModel">
  <Border Classes="glass-panel">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10" MinHeight="188">
      <StackPanel Spacing="4">
        <TextBlock Classes="section-title" Text="{Binding HeroTitle}" />
        <TextBlock Classes="muted-text" Text="{Binding HeroSummary}" />
      </StackPanel>

      <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
        <Border Classes="status-pill">
          <TextBlock Text="{Binding SourceSummary}" />
        </Border>
        <Border Grid.Column="1" Classes="status-pill">
          <TextBlock Text="{Binding FilterSummary}" />
        </Border>
        <Border Grid.Column="2" Classes="status-pill">
          <TextBlock Text="{Binding MetricModeSummary}" />
        </Border>
        <StackPanel Grid.Column="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
          <Border Classes="status-pill">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Width="10"
                      Height="10"
                      CornerRadius="5"
                      Background="{StaticResource CosmosSecondaryBrush}"
                      VerticalAlignment="Center" />
              <TextBlock Text="{Binding HeroLegendPrimary}" />
            </StackPanel>
          </Border>
          <Border Classes="status-pill">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Width="10"
                      Height="10"
                      CornerRadius="5"
                      Background="{StaticResource CosmosPrimaryBrush}"
                      VerticalAlignment="Center" />
              <TextBlock Text="{Binding HeroLegendSecondary}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <Border Grid.Row="2" Background="{StaticResource CosmosSurfaceHighBrush}" CornerRadius="12" Padding="12" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
          <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
            <Border Classes="status-pill">
              <TextBlock Text="Traffic timeline" />
            </Border>
            <Border Grid.Column="1" Classes="status-pill">
              <TextBlock Text="Real tick history" />
            </Border>
          </Grid>

          <Grid Grid.Row="1" ColumnDefinitions="44,*" ColumnSpacing="10">
            <Grid RowDefinitions="*,*,*,*,*" Margin="0,4,0,18">
              <TextBlock Grid.Row="0" Classes="muted-text" FontSize="11" HorizontalAlignment="Right" Text="{Binding YAxisTopLabel}" />
              <TextBlock Grid.Row="1" Classes="muted-text" FontSize="11" HorizontalAlignment="Right" Text="{Binding YAxisUpperMidLabel}" />
              <TextBlock Grid.Row="2" Classes="muted-text" FontSize="11" HorizontalAlignment="Right" Text="{Binding YAxisMidLabel}" />
              <TextBlock Grid.Row="3" Classes="muted-text" FontSize="11" HorizontalAlignment="Right" Text="{Binding YAxisLowerMidLabel}" />
              <TextBlock Grid.Row="4" Classes="muted-text" FontSize="11" HorizontalAlignment="Right" Text="{Binding YAxisZeroLabel}" />
            </Grid>

            <Border Grid.Column="1" Background="{StaticResource CosmosSurfaceBrush}" CornerRadius="10" Padding="10" ClipToBounds="True">
              <Grid>
                <Grid Width="640" Height="84" Opacity="0.32"
                      IsVisible="{Binding HasTimeline}">
                  <Border VerticalAlignment="Top" Margin="0,14,0,0" Height="1" Background="#2A313D" />
                  <Border VerticalAlignment="Top" Margin="0,32,0,0" Height="1" Background="#2A313D" />
                  <Border VerticalAlignment="Top" Margin="0,50,0,0" Height="1" Background="#2A313D" />
                  <Border VerticalAlignment="Top" Margin="0,68,0,0" Height="1" Background="#2A313D" />
                </Grid>

                <Viewbox Stretch="Fill" IsVisible="{Binding HasTimeline}">
                  <Canvas Width="640" Height="84" ClipToBounds="True">
                    <shapes:Path Canvas.Left="0" Canvas.Top="0" Width="640" Height="84"
                                 Opacity="0.05"
                                 StrokeThickness="0"
                                 Fill="{StaticResource CosmosSecondaryBrush}"
                                 Data="{Binding OutboundAreaPathData}" />

                    <shapes:Path Canvas.Left="0" Canvas.Top="0" Width="640" Height="84"
                                 Opacity="0.07"
                                 Stroke="{StaticResource CosmosSecondaryBrush}"
                                 StrokeThickness="1.3"
                                 Fill="Transparent"
                                 Data="{Binding OutboundPathData}" />

                    <shapes:Path Canvas.Left="0" Canvas.Top="0" Width="640" Height="84"
                                 Opacity="0.06"
                                 Stroke="{StaticResource CosmosPrimaryBrush}"
                                 StrokeThickness="1.15"
                                 Fill="Transparent"
                                 Data="{Binding InboundPathData}" />

                    <shapes:Path Canvas.Left="0" Canvas.Top="0" Width="640" Height="84"
                                 StrokeThickness="0.68"
                                 Stroke="{StaticResource CosmosSecondaryBrush}"
                                 Fill="Transparent"
                                 Data="{Binding OutboundPathData}" />

                    <shapes:Path Canvas.Left="0" Canvas.Top="0" Width="640" Height="84"
                                 StrokeThickness="0.6"
                                 Stroke="{StaticResource CosmosPrimaryBrush}"
                                 Fill="Transparent"
                                 Data="{Binding InboundPathData}" />
                  </Canvas>
                </Viewbox>

                <StackPanel IsVisible="{Binding HasNoTimeline}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="6">
                  <TextBlock FontWeight="SemiBold"
                             HorizontalAlignment="Center"
                             Text="{Binding TimelineEmptyTitle}" />
                  <TextBlock Classes="muted-text"
                             HorizontalAlignment="Center"
                             TextAlignment="Center"
                             TextWrapping="Wrap"
                             MaxWidth="360"
                             Text="{Binding TimelineEmptyMessage}" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>

          <Grid Grid.Row="2" ColumnDefinitions="44,*,*,*,*,*" ColumnSpacing="8" Margin="0,0,2,0">
            <TextBlock Classes="muted-text" FontSize="11" HorizontalAlignment="Right" Text="" />
            <TextBlock Grid.Column="1" Classes="muted-text" FontSize="11" HorizontalAlignment="Left" Text="{Binding AxisLabelStart}" />
            <TextBlock Grid.Column="2" Classes="muted-text" FontSize="11" HorizontalAlignment="Center" Text="{Binding AxisLabelMidLeft}" />
            <TextBlock Grid.Column="3" Classes="muted-text" FontSize="11" HorizontalAlignment="Center" Text="{Binding AxisLabelCenter}" />
            <TextBlock Grid.Column="4" Classes="muted-text" FontSize="11" HorizontalAlignment="Center" Text="{Binding AxisLabelMidRight}" />
            <TextBlock Grid.Column="5" Classes="muted-text" FontSize="11" HorizontalAlignment="Right" Text="{Binding AxisLabelEnd}" />
          </Grid>
        </Grid>
      </Border>

      <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="10">
        <Border Classes="status-pill">
          <TextBlock Text="Live/Offline Supported" />
        </Border>
        <Border Grid.Column="1" Classes="status-pill">
          <TextBlock Text="Phase1 snapshot aligned" />
        </Border>
        <Border Grid.Column="2" Classes="status-pill">
          <TextBlock Text="Real timeline" />
        </Border>
        <StackPanel Grid.Column="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
          <Border Classes="status-pill">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Out" FontWeight="SemiBold" />
              <TextBlock Classes="muted-text" Text="{Binding OutboundSummary}" />
            </StackPanel>
          </Border>
          <Border Classes="status-pill">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="In" FontWeight="SemiBold" />
              <TextBlock Classes="muted-text" Text="{Binding InboundSummary}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
