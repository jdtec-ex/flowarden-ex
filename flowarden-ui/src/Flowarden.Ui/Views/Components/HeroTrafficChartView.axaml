<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.Components.HeroTrafficChartView"
             x:DataType="vm:OverviewPageViewModel">
  <Border Classes="glass-panel">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12" MinHeight="220">
      <StackPanel>
        <TextBlock Classes="section-title" Text="{Binding HeroTitle}" />
        <TextBlock Classes="muted-text" Text="{Binding HeroSummary}" />
      </StackPanel>

      <Border Grid.Row="1" Background="{StaticResource CosmosSurfaceHighBrush}" CornerRadius="12" Padding="16">
        <Grid ColumnDefinitions="*,*,*,*" VerticalAlignment="Bottom" Height="120" ColumnSpacing="10">
          <Border Background="{StaticResource CosmosSecondaryBrush}" CornerRadius="10,10,0,0" Height="42" VerticalAlignment="Bottom" />
          <Border Grid.Column="1" Background="{StaticResource CosmosPrimaryBrush}" CornerRadius="10,10,0,0" Height="85" VerticalAlignment="Bottom" />
          <Border Grid.Column="2" Background="{StaticResource CosmosSecondaryBrush}" CornerRadius="10,10,0,0" Height="58" VerticalAlignment="Bottom" />
          <Border Grid.Column="3" Background="{StaticResource CosmosPrimaryBrush}" CornerRadius="10,10,0,0" Height="103" VerticalAlignment="Bottom" />
        </Grid>
      </Border>

      <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
        <Border Classes="status-pill">
          <TextBlock Text="Live/Offline Supported" />
        </Border>
        <Border Grid.Column="1" Classes="status-pill">
          <TextBlock Text="Phase1 snapshot aligned" />
        </Border>
      </Grid>
    </Grid>
  </Border>
</UserControl>
