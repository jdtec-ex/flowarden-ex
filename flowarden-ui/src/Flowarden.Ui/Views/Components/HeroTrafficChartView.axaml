<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shapes="using:Avalonia.Controls.Shapes"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.Components.HeroTrafficChartView"
             x:DataType="vm:OverviewPageViewModel">
  <Border Classes="tfc-panel" ClipToBounds="True">
    <Grid RowDefinitions="32,*">
      <Border Classes="tfc-panel-header" Padding="16,0">
        <Grid ColumnDefinitions="*,Auto" Height="32">
          <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="Traffic Throughput" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Width="14" Height="2" Background="{StaticResource TfcInboundBrush}" VerticalAlignment="Center" />
              <TextBlock Classes="tfc-label" Text="INBOUND" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Width="14" Height="2" Background="{StaticResource TfcOutboundBrush}" VerticalAlignment="Center" />
              <TextBlock Classes="tfc-label" Text="OUTBOUND" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Background="{StaticResource TfcBackgroundBrush}" Padding="20" ClipToBounds="True">
        <Grid>
          <Grid RowDefinitions="*,*,*,*,*" Opacity="0.72">
            <Border Background="{StaticResource TfcBorderBrush}" Height="1" VerticalAlignment="Top" />
            <Border Grid.Row="1" Background="{StaticResource TfcBorderBrush}" Height="1" VerticalAlignment="Top" />
            <Border Grid.Row="2" Background="{StaticResource TfcBorderBrush}" Height="1" VerticalAlignment="Top" />
            <Border Grid.Row="3" Background="{StaticResource TfcBorderBrush}" Height="1" VerticalAlignment="Top" />
            <Border Grid.Row="4" Background="{StaticResource TfcBorderBrush}" Height="1" VerticalAlignment="Bottom" />
          </Grid>

          <Grid ColumnDefinitions="52,*" RowDefinitions="*,28">
            <Grid RowDefinitions="*,*,*,*,*" Margin="0,0,8,0">
              <TextBlock Classes="tfc-data" Foreground="{StaticResource TfcDimTextBrush}" FontSize="10" HorizontalAlignment="Right" Text="{Binding YAxisTopLabel}" />
              <TextBlock Grid.Row="1" Classes="tfc-data" Foreground="{StaticResource TfcDimTextBrush}" FontSize="10" HorizontalAlignment="Right" Text="{Binding YAxisUpperMidLabel}" />
              <TextBlock Grid.Row="2" Classes="tfc-data" Foreground="{StaticResource TfcDimTextBrush}" FontSize="10" HorizontalAlignment="Right" Text="{Binding YAxisMidLabel}" />
              <TextBlock Grid.Row="3" Classes="tfc-data" Foreground="{StaticResource TfcDimTextBrush}" FontSize="10" HorizontalAlignment="Right" Text="{Binding YAxisLowerMidLabel}" />
              <TextBlock Grid.Row="4" Classes="tfc-data" Foreground="{StaticResource TfcDimTextBrush}" FontSize="10" HorizontalAlignment="Right" Text="{Binding YAxisZeroLabel}" />
            </Grid>

            <Grid x:Name="ThroughputPlotHost"
                  Grid.Column="1"
                  Background="Transparent"
                  ClipToBounds="True"
                  PointerMoved="OnPlotPointerMoved"
                  PointerExited="OnPlotPointerExited">
              <Viewbox Stretch="Fill" IsHitTestVisible="False">
                <Canvas Width="640" Height="260" ClipToBounds="True">
                  <shapes:Path Canvas.Left="0" Canvas.Top="0" Width="640" Height="260"
                               StrokeThickness="1.6"
                               Stroke="{StaticResource TfcInboundBrush}"
                               Fill="Transparent"
                               Data="{Binding InboundPathData}"
                               IsVisible="{Binding HasTimeline}"
                               Stretch="Fill" />
                  <shapes:Path Canvas.Left="0" Canvas.Top="0" Width="640" Height="260"
                               StrokeThickness="1.6"
                               Stroke="{StaticResource TfcOutboundBrush}"
                               Fill="Transparent"
                               Data="{Binding OutboundPathData}"
                               IsVisible="{Binding HasTimeline}"
                               Stretch="Fill" />
                </Canvas>
              </Viewbox>

              <Canvas HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      IsHitTestVisible="False"
                      IsVisible="{Binding IsThroughputHoverVisible}">
                <Border Width="1"
                        Height="{Binding ThroughputHoverPlotHeight}"
                        Background="{StaticResource TfcBorderHighBrush}"
                        Opacity="0.82"
                        Canvas.Left="{Binding ThroughputHoverMarkerLeft}" />
                <Border Classes="tfc-panel-low"
                        Width="172"
                        Padding="12"
                        Canvas.Left="{Binding ThroughputHoverPanelLeft}"
                        Canvas.Top="{Binding ThroughputHoverPanelTop}">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="tfc-label" Text="CURRENT THROUGHPUT" />
                    <TextBlock Classes="tfc-data"
                               FontSize="11"
                               Foreground="{StaticResource TfcDimTextBrush}"
                               Text="{Binding ThroughputHoverTimeLabel}" />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="18">
                      <TextBlock Classes="tfc-data" Foreground="{StaticResource TfcInboundBrush}" Text="IN" />
                      <TextBlock Grid.Column="1" Classes="tfc-data" HorizontalAlignment="Right" Text="{Binding ThroughputHoverInboundLabel}" />
                      <TextBlock Grid.Row="1" Classes="tfc-data" Foreground="{StaticResource TfcOutboundBrush}" Text="OUT" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Classes="tfc-data" HorizontalAlignment="Right" Text="{Binding ThroughputHoverOutboundLabel}" />
                    </Grid>
                  </StackPanel>
                </Border>
              </Canvas>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
              <TextBlock Classes="tfc-data" Foreground="{StaticResource TfcDimTextBrush}" FontSize="11" Text="{Binding AxisLabelStart}" />
              <TextBlock Grid.Column="1" Classes="tfc-data" Foreground="{StaticResource TfcDimTextBrush}" FontSize="11" HorizontalAlignment="Center" Text="{Binding AxisLabelMidLeft}" />
              <TextBlock Grid.Column="2" Classes="tfc-data" Foreground="{StaticResource TfcDimTextBrush}" FontSize="11" HorizontalAlignment="Center" Text="{Binding AxisLabelCenter}" />
              <TextBlock Grid.Column="3" Classes="tfc-data" Foreground="{StaticResource TfcDimTextBrush}" FontSize="11" HorizontalAlignment="Center" Text="{Binding AxisLabelMidRight}" />
              <TextBlock Grid.Column="4" Classes="tfc-data" Foreground="{StaticResource TfcDimTextBrush}" FontSize="11" HorizontalAlignment="Right" Text="{Binding AxisLabelEnd}" />
            </Grid>
          </Grid>

          <StackPanel IsVisible="{Binding HasNoTimeline}"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Spacing="8">
            <TextBlock FontWeight="SemiBold" Text="{Binding TimelineEmptyTitle}" HorizontalAlignment="Center" />
            <TextBlock Classes="muted-text" Text="{Binding TimelineEmptyMessage}" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
