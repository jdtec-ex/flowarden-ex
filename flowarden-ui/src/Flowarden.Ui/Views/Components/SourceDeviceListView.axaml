<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.Components.SourceDeviceListView"
             x:DataType="vm:SourcePageViewModel">
  <Border Classes="tfc-panel" ClipToBounds="True">
    <Grid RowDefinitions="64,*">
      <Border Classes="tfc-panel-header" Padding="14,0">
        <Grid ColumnDefinitions="*,Auto" Height="64">
          <TextBlock VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="Interfaces" />
          <Border Grid.Column="1" Classes="tfc-chip" Padding="8,3" VerticalAlignment="Center">
            <TextBlock Classes="tfc-label" Text="{Binding DeviceItems.Count, StringFormat={}{0} FOUND}" />
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <Border Padding="18"
                IsVisible="{Binding HasNoDevices}">
          <StackPanel VerticalAlignment="Center" Spacing="8">
            <TextBlock Classes="section-title" Text="No interfaces discovered" />
            <TextBlock Classes="muted-text"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Text="Waiting for the resident core to return capture interfaces." />
          </StackPanel>
        </Border>

        <ListBox ItemsSource="{Binding DeviceItems}"
                 SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                 IsVisible="{Binding HasDevices}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SourceDeviceItemViewModel">
              <Border Background="{Binding CardBackground}"
                      BorderBrush="{Binding CardBorderBrush}"
                      BorderThickness="{Binding CardBorderThickness}"
                      Padding="16,14">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Grid ColumnDefinitions="36,*" ColumnSpacing="10">
                      <Border Width="36"
                              Height="36"
                              Background="{Binding InterfaceIconBackground}"
                              BorderBrush="{Binding InterfaceAccentBrush}"
                              BorderThickness="1"
                              CornerRadius="4">
                        <TextBlock FontFamily="JetBrains Mono, Menlo, Consolas, monospace"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding InterfaceAccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{Binding InterfaceIconText}" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <SelectableTextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                        <TextBlock Classes="tfc-label"
                                   Foreground="{Binding InterfaceAccentBrush}"
                                   Text="{Binding InterfaceTypeLabel}" />
                      </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Border Width="7" Height="7" CornerRadius="1" Background="{Binding StatusDotBrush}" />
                      <TextBlock Classes="tfc-label" Foreground="{Binding StatusForeground}" Text="{Binding ShortStatusLabel}" />
                    </StackPanel>
                  </Grid>

                  <SelectableTextBlock Grid.Row="1"
                                       Classes="muted-text"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Description}" />

                  <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border Classes="tfc-panel-low" Padding="10,7">
                      <StackPanel>
                        <TextBlock Classes="tfc-label" Text="RX PACKETS" />
                        <SelectableTextBlock Classes="tfc-data" Text="{Binding RxPacketsLabel}" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="tfc-panel-low" Padding="10,7">
                      <StackPanel>
                        <TextBlock Classes="tfc-label" Text="TX PACKETS" />
                        <SelectableTextBlock Classes="tfc-data" Text="{Binding TxPacketsLabel}" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Grid>
  </Border>
</UserControl>
