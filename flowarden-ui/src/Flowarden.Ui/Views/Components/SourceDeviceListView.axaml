<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.Components.SourceDeviceListView"
             x:DataType="vm:SourcePageViewModel">
  <Border Classes="glass-panel">
    <Grid RowDefinitions="Auto,*" RowSpacing="12">
      <TextBlock Classes="section-title" Text="Device List" />

      <ListBox Grid.Row="1"
               ItemsSource="{Binding DeviceItems}"
               SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
               Background="Transparent"
               BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SourceDeviceItemViewModel">
            <Border Classes="source-device-item"
                    Background="{Binding CardBackground}"
                    BorderBrush="{Binding CardBorderBrush}"
                    BorderThickness="{Binding CardBorderThickness}">
              <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="4">
                    <SelectableTextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                    <SelectableTextBlock Classes="muted-text" Text="{Binding Description}" />
                  </StackPanel>
                  <Border Grid.Column="1"
                          Background="{Binding StatusBackground}"
                          CornerRadius="999"
                          Padding="10,6">
                    <SelectableTextBlock FontSize="12"
                                         FontWeight="SemiBold"
                                         Foreground="{Binding StatusForeground}"
                                         Text="{Binding PreviewStatusLabel}" />
                  </Border>
                </Grid>

                <SelectableTextBlock Grid.Row="1"
                                     Classes="muted-text"
                                     Text="{Binding PreviewSummary}" />

                <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <SelectableTextBlock FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding StatusForeground}"
                                       Text="{Binding SelectionLabel}" />
                  <SelectableTextBlock Grid.Column="1"
                                       Classes="muted-text"
                                       Text="{Binding ReadinessLabel}" />
                </Grid>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Border>
</UserControl>
