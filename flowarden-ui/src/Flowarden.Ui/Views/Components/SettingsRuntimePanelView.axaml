<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.Components.SettingsRuntimePanelView"
             x:DataType="vm:SettingsPageViewModel">
  <Border Classes="tfc-panel" Padding="20,18">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
      <TextBlock Classes="section-title" Text="Runtime Status" />
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
        <Border Classes="tfc-chip" Padding="10,5">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Width="8" Height="8" Background="{StaticResource TfcGoodBrush}" VerticalAlignment="Center" />
            <TextBlock Classes="tfc-label" Text="CORE: ACTIVE" />
          </StackPanel>
        </Border>
        <Border Classes="tfc-chip" Padding="10,5">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Width="8" Height="8" Background="{StaticResource TfcWarningBrush}" VerticalAlignment="Center" />
            <TextBlock Classes="tfc-label" Text="{Binding RuntimeState.CaptureStatus, StringFormat=CAPTURE: {0}}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <Grid Grid.Row="2"
            ColumnDefinitions="*,*"
            RowDefinitions="Auto,Auto"
            RowSpacing="14"
            ColumnSpacing="32"
            VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Classes="muted-text" FontSize="13" Text="Operating Mode" />
          <TextBlock FontSize="14" Text="{Binding RuntimeState.Mode}" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Classes="muted-text" FontSize="13" Text="Current Source" />
          <TextBlock Classes="tfc-data" Text="{Binding RuntimeState.SourceDisplayName}" />
        </StackPanel>
        <StackPanel Grid.Row="1">
          <TextBlock Classes="muted-text" FontSize="13" Text="BPF Filter" />
          <TextBlock Classes="tfc-data" Text="{Binding RuntimeState.Bpf}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1">
          <TextBlock Classes="muted-text" FontSize="13" Text="Started At" />
          <TextBlock Classes="tfc-data" Text="{Binding StartedAtLabel}" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
