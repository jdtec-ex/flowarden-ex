<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.Components.InspectResultsTableView"
             x:DataType="vm:InspectPageViewModel">
  <Border Classes="glass-panel">
    <Grid RowDefinitions="Auto,*" RowSpacing="12">
      <Grid ColumnDefinitions="1.9*,68,2.1*,68,76,116,92,104,82" ColumnSpacing="6">
        <TextBlock Classes="muted-text" FontWeight="SemiBold" Text="Source" />
        <TextBlock Grid.Column="1"
                   Classes="muted-text"
                   FontWeight="SemiBold"
                   Text="Src Port" />
        <TextBlock Grid.Column="2" Classes="muted-text" FontWeight="SemiBold" Text="Destination" />
        <TextBlock Grid.Column="3"
                   Classes="muted-text"
                   FontWeight="SemiBold"
                   Text="Dst Port" />
        <TextBlock Grid.Column="4" Classes="muted-text" FontWeight="SemiBold" Text="Proto" />
        <TextBlock Grid.Column="5" Classes="muted-text" FontWeight="SemiBold" Text="Service" />
        <TextBlock Grid.Column="6" Classes="muted-text" FontWeight="SemiBold" Text="Direction" />
        <TextBlock Grid.Column="7"
                   Classes="muted-text"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Right"
                   Text="Bytes" />
        <TextBlock Grid.Column="8"
                   Classes="muted-text"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Right"
                   Text="Packets" />
      </Grid>

      <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="status-pill" Margin="0,0,0,8">
                <Grid ColumnDefinitions="1.9*,68,2.1*,68,76,116,92,104,82" ColumnSpacing="6">
                  <TextBlock Text="{Binding SourceAddress}" />
                  <TextBlock Grid.Column="1" Text="{Binding SourcePort}" />
                  <TextBlock Grid.Column="2" Text="{Binding DestinationAddress}" />
                  <TextBlock Grid.Column="3" Text="{Binding DestinationPort}" />
                  <TextBlock Grid.Column="4" Text="{Binding Protocol}" />
                  <TextBlock Grid.Column="5" Text="{Binding ServiceName}" />
                  <TextBlock Grid.Column="6" Text="{Binding Direction}" />
                  <TextBlock Grid.Column="7"
                             HorizontalAlignment="Right"
                             Text="{Binding Bytes}" />
                  <TextBlock Grid.Column="8"
                             HorizontalAlignment="Right"
                             Text="{Binding Packets}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
