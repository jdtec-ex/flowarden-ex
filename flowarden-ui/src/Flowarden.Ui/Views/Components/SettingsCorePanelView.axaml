<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.Components.SettingsCorePanelView"
             x:DataType="vm:SettingsPageViewModel">
  <Border Classes="tfc-panel" Padding="20,18">
    <Grid RowDefinitions="Auto,Auto,1,Auto,Auto" RowSpacing="14">
      <TextBlock Classes="section-title" Text="Core Connection" />
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Classes="muted-text" FontSize="13" Text="Core Version" />
          <TextBlock Classes="tfc-data" Text="{Binding CoreVersion}" />
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
          <TextBlock Classes="muted-text" FontSize="13" HorizontalAlignment="Right" Text="Health" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Width="8" Height="8" Background="{StaticResource TfcGoodBrush}" VerticalAlignment="Center" />
            <TextBlock Foreground="{StaticResource TfcGoodBrush}" Text="{Binding CoreHealth.Status}" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <Border Grid.Row="2" Height="1" Background="{StaticResource TfcBorderBrush}" />

      <StackPanel Grid.Row="3" Spacing="8">
        <TextBlock Classes="tfc-label" Text="DAEMON ENDPOINT" />
        <Grid ColumnDefinitions="*,136" ColumnSpacing="10">
          <Border Classes="tfc-panel-low" Height="32" Padding="10,0">
            <SelectableTextBlock Classes="tfc-data" Text="{Binding CoreEndpoint}" />
          </Border>
          <Button Grid.Column="1" Classes="tools-button" Height="32" Content="Reconnect" />
        </Grid>
      </StackPanel>

      <TextBlock Grid.Row="4" Classes="muted-text" FontSize="13" Text="{Binding CoreEndpointSource}" />
    </Grid>
  </Border>
</UserControl>
