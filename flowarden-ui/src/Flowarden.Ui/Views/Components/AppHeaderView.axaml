<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.Components.AppHeaderView"
             x:DataType="vm:AppShellViewModel">
  <Border Classes="glass-panel app-header">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <StackPanel Spacing="4">
        <TextBlock Classes="page-title" Text="{Binding CurrentPage.Title}" />
        <TextBlock Classes="muted-text" Text="{Binding HeaderSupportingText}" TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
        <Border Classes="status-pill status-pill-good">
          <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
            <Ellipse Width="10"
                     Height="10"
                     Fill="{StaticResource CosmosGoodBrush}"
                     VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{Binding CoreStatus.Label}"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="2"
                       Classes="muted-text"
                       Text="{Binding CoreStatus.Value}"
                       VerticalAlignment="Center" />
          </Grid>
        </Border>

        <Border Classes="status-pill">
          <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
            <Ellipse Width="10"
                     Height="10"
                     Fill="{StaticResource CosmosSecondaryBrush}"
                     VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{Binding CaptureStatus.Label}"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="2"
                       Classes="muted-text"
                       Text="{Binding CaptureStatus.Value}"
                       VerticalAlignment="Center" />
          </Grid>
        </Border>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
