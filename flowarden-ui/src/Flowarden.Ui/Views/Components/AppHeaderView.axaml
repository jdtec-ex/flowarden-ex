<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.Components.AppHeaderView"
             x:DataType="vm:AppShellViewModel">
  <Border Classes="glass-panel app-header">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <StackPanel Spacing="4">
        <TextBlock Classes="page-title" Text="{Binding CurrentPage.Title}" />
        <TextBlock Classes="muted-text" Text="{Binding HeaderSupportingText}" TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
        <Border Classes="status-pill status-pill-good">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="10" Height="10" Fill="{StaticResource CosmosGoodBrush}" />
            <TextBlock Text="{Binding CoreStatus.Label}" />
            <TextBlock Classes="muted-text" Text="{Binding CoreStatus.Value}" />
          </StackPanel>
        </Border>

        <Border Classes="status-pill">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="10" Height="10" Fill="{StaticResource CosmosSecondaryBrush}" />
            <TextBlock Text="{Binding CaptureStatus.Label}" />
            <TextBlock Classes="muted-text" Text="{Binding CaptureStatus.Value}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
