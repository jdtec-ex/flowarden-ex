<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.Components.AppHeaderView"
             x:DataType="vm:AppShellViewModel">
  <Border Classes="app-header">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Height="48">
      <StackPanel Orientation="Horizontal"
                  Spacing="10"
                  VerticalAlignment="Center">
        <TextBlock FontSize="16"
                   FontWeight="SemiBold"
                   Text="Console Dashboard" />
        <TextBlock Classes="muted-text"
                   Text="/"
                   VerticalAlignment="Center"
                   IsVisible="{Binding IsNotOverviewPageActive}" />
        <TextBlock Foreground="{StaticResource TfcPrimaryBrush}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Text="{Binding CurrentPage.Title}"
                   IsVisible="{Binding IsNotOverviewPageActive}" />
      </StackPanel>

      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="8"
                  VerticalAlignment="Center"
                  Margin="0,0,8,0">
        <Button Classes="tools-button"
                Width="28"
                Height="24"
                Padding="0"
                Command="{Binding ToggleThumbnailCommand}"
                ToolTip.Tip="Thumbnail mode (compact always-on-top)">
          <TextBlock FontSize="11" Text="▣" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Button>
      </StackPanel>

      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="12"
                  VerticalAlignment="Center"
                  Margin="40,0,0,0"
                  IsVisible="{Binding IsSourcePageActive}">
        <TextBlock Classes="tfc-label"
                   VerticalAlignment="Center"
                   Text="{Binding SourcePage.HeaderRefreshLabel}" />
        <Button Classes="tools-button"
                Width="24"
                Height="24"
                Padding="0"
                Command="{Binding SourcePage.RefreshPreviewCommand}"
                ToolTip.Tip="Refresh preview">
          <PathIcon Width="13"
                    Height="13"
                    Data="{StaticResource IconRefresh}"
                    Foreground="{StaticResource TfcPrimaryBrush}" />
        </Button>
        
        <Border Width="1" Height="18" Background="{StaticResource TfcBorderBrush}" />
        <Button Classes="tools-button"
                Command="{Binding SourcePage.ImportOfflineCommand}"
                Content="Import Offline" />
        <TextBlock Classes="tfc-label"
                   VerticalAlignment="Center"
                   Text="SENSORS" />
      </StackPanel>

      <Border Grid.Column="1"
              Background="Transparent"
              BorderBrush="Transparent"
              BorderThickness="1"
              CornerRadius="3"
              Padding="0"
              VerticalAlignment="Center"
              IsVisible="{Binding IsInspectPageActive}">
        <StackPanel Orientation="Horizontal" Spacing="3">
          <Button Background="{Binding InspectPage.FlowModeBackground}"
                  BorderBrush="{Binding InspectPage.FlowModeBorderBrush}"
                  BorderThickness="1"
                  Width="24"
                  Height="24"
                  Padding="0"
                  Command="{Binding InspectPage.SwitchToFlowsCommand}"
                  ToolTip.Tip="Flows">
            <PathIcon Width="10"
                      Height="10"
                      Data="{StaticResource IconGridSquare}"
                      Foreground="{Binding InspectPage.FlowModeForeground}" />
          </Button>
          <Button Background="{Binding InspectPage.TcpModeBackground}"
                  BorderBrush="{Binding InspectPage.TcpModeBorderBrush}"
                  BorderThickness="1"
                  Width="24"
                  Height="24"
                  Padding="0"
                  Command="{Binding InspectPage.SwitchToTcpConnectionsCommand}"
                  ToolTip.Tip="TCP Connections">
            <PathIcon Width="10"
                      Height="10"
                      Data="{StaticResource IconGridView}"
                      Foreground="{Binding InspectPage.TcpModeForeground}" />
          </Button>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
