<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.Components.AppHeaderView"
             x:DataType="vm:AppShellViewModel">
  <Border Classes="glass-panel app-header">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="16">
      <StackPanel>
        <TextBlock Classes="page-title" Text="{Binding CurrentPage.Title}" />
        <TextBlock Classes="muted-text" Text="{Binding CurrentPage.Description}" TextWrapping="Wrap" />
        <TextBlock Classes="muted-text" Text="{Binding ConnectionMessage}" />
      </StackPanel>

      <Button Grid.Column="1"
              Classes="mode-button"
              Command="{Binding ToggleModeCommand}"
              Content="{Binding ActiveMode}" />

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
        <Border Classes="status-pill status-pill-good">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="10" Height="10" Fill="{StaticResource CosmosGoodBrush}" />
            <TextBlock Text="{Binding CoreStatus.Label}" />
            <TextBlock Classes="muted-text" Text="{Binding CoreStatus.Value}" />
          </StackPanel>
        </Border>

        <Border Classes="status-pill">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="10" Height="10" Fill="{StaticResource CosmosSecondaryBrush}" />
            <TextBlock Text="{Binding CaptureStatus.Label}" />
            <TextBlock Classes="muted-text" Text="{Binding CaptureStatus.Value}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <Button Grid.Column="3"
              Classes="tools-button"
              Command="{Binding OpenToolsCommand}"
              Content="Tools" />
    </Grid>
  </Border>
</UserControl>
