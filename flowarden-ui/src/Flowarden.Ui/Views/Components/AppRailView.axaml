<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shapes="using:Avalonia.Controls.Shapes"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.Components.AppRailView"
             x:DataType="vm:AppShellViewModel">
  <Border Classes="app-rail">
    <DockPanel LastChildFill="True">
      <StackPanel DockPanel.Dock="Top" Spacing="28">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock FontSize="24"
                       FontWeight="SemiBold"
                       Text="{Binding Title}"
                       VerticalAlignment="Center" />
            <Border Classes="tfc-chip"
                    Background="{StaticResource TfcRaisedHighBrush}"
                    BorderBrush="{StaticResource TfcPrimaryBrush}"
                    Padding="8,2"
                    VerticalAlignment="Center">
              <TextBlock Classes="tfc-label"
                         Foreground="{StaticResource TfcPrimaryBrush}"
                         FontSize="10"
                         Text="BETA" />
            </Border>
          </StackPanel>
          <TextBlock Classes="tfc-label"
                     Text="{Binding Subtitle}" />
        </StackPanel>

        <StackPanel Spacing="0">
          <Button Command="{Binding NavigateCommand}"
                  CommandParameter="overview"
                  Classes="nav-button">
            <Grid ColumnDefinitions="3,Auto,*" ColumnSpacing="12">
              <Border Grid.ColumnSpan="3"
                      Background="{StaticResource TfcRaisedBrush}"
                      IsVisible="{Binding IsOverviewPageActive}" />
              <Border Background="{StaticResource TfcPrimaryBrush}"
                      IsVisible="{Binding IsOverviewPageActive}" />
              <Viewbox Grid.Column="1" Width="18" Height="18">
                <Canvas Width="24" Height="24">
                  <shapes:Rectangle Width="7" Height="7" Canvas.Left="4" Canvas.Top="4"
                                    Stroke="{StaticResource TfcMutedTextBrush}" StrokeThickness="1.8" />
                  <shapes:Rectangle Width="7" Height="7" Canvas.Left="13" Canvas.Top="4"
                                    Stroke="{StaticResource TfcMutedTextBrush}" StrokeThickness="1.8" />
                  <shapes:Rectangle Width="7" Height="7" Canvas.Left="4" Canvas.Top="13"
                                    Stroke="{StaticResource TfcMutedTextBrush}" StrokeThickness="1.8" />
                  <shapes:Rectangle Width="7" Height="7" Canvas.Left="13" Canvas.Top="13"
                                    Stroke="{StaticResource TfcMutedTextBrush}" StrokeThickness="1.8" />
                </Canvas>
              </Viewbox>
              <TextBlock Grid.Column="2" Text="Overview" VerticalAlignment="Center" />
            </Grid>
          </Button>

          <Button Command="{Binding NavigateCommand}"
                  CommandParameter="source"
                  Classes="nav-button">
            <Grid ColumnDefinitions="3,Auto,*" ColumnSpacing="12">
              <Border Grid.ColumnSpan="3"
                      Background="{StaticResource TfcRaisedBrush}"
                      IsVisible="{Binding IsSourcePageActive}" />
              <Border Background="{StaticResource TfcPrimaryBrush}"
                      IsVisible="{Binding IsSourcePageActive}" />
              <Viewbox Grid.Column="1" Width="18" Height="18">
                <Canvas Width="24" Height="24">
                  <shapes:Line StartPoint="12,5" EndPoint="12,11" Stroke="{StaticResource TfcMutedTextBrush}" StrokeThickness="1.8" />
                  <shapes:Line StartPoint="7,16" EndPoint="17,16" Stroke="{StaticResource TfcMutedTextBrush}" StrokeThickness="1.8" />
                  <shapes:Line StartPoint="7,16" EndPoint="12,11" Stroke="{StaticResource TfcMutedTextBrush}" StrokeThickness="1.8" />
                  <shapes:Line StartPoint="17,16" EndPoint="12,11" Stroke="{StaticResource TfcMutedTextBrush}" StrokeThickness="1.8" />
                  <shapes:Rectangle Width="5" Height="5" Canvas.Left="9.5" Canvas.Top="3" Stroke="{StaticResource TfcMutedTextBrush}" StrokeThickness="1.5" />
                  <shapes:Rectangle Width="5" Height="5" Canvas.Left="4.5" Canvas.Top="14" Stroke="{StaticResource TfcMutedTextBrush}" StrokeThickness="1.5" />
                  <shapes:Rectangle Width="5" Height="5" Canvas.Left="14.5" Canvas.Top="14" Stroke="{StaticResource TfcMutedTextBrush}" StrokeThickness="1.5" />
                </Canvas>
              </Viewbox>
              <TextBlock Grid.Column="2" Text="Source" VerticalAlignment="Center" />
            </Grid>
          </Button>

          <Button Command="{Binding NavigateCommand}"
                  CommandParameter="inspect"
                  Classes="nav-button">
            <Grid ColumnDefinitions="3,Auto,*" ColumnSpacing="12">
              <Border Grid.ColumnSpan="3"
                      Background="{StaticResource TfcRaisedBrush}"
                      IsVisible="{Binding IsInspectPageActive}" />
              <Border Background="{StaticResource TfcPrimaryBrush}"
                      IsVisible="{Binding IsInspectPageActive}" />
              <Viewbox Grid.Column="1" Width="18" Height="18">
                <Canvas Width="24" Height="24">
                  <shapes:Ellipse Width="10" Height="10" Canvas.Left="5" Canvas.Top="5"
                                  Stroke="{StaticResource TfcMutedTextBrush}" StrokeThickness="1.8" />
                  <shapes:Line StartPoint="13.5,13.5" EndPoint="19,19"
                               Stroke="{StaticResource TfcMutedTextBrush}" StrokeThickness="1.8"
                               StrokeLineCap="Round" />
                  <shapes:Ellipse Width="3" Height="3" Canvas.Left="8.5" Canvas.Top="8.5"
                                  Fill="{StaticResource TfcMutedTextBrush}" />
                </Canvas>
              </Viewbox>
              <TextBlock Grid.Column="2" Text="Inspect" VerticalAlignment="Center" />
            </Grid>
          </Button>

          <Button Command="{Binding NavigateCommand}"
                  CommandParameter="signals"
                  Classes="nav-button">
            <Grid ColumnDefinitions="3,Auto,*" ColumnSpacing="12">
              <Border Grid.ColumnSpan="3"
                      Background="{StaticResource TfcRaisedBrush}"
                      IsVisible="{Binding IsSignalsPageActive}" />
              <Border Background="{StaticResource TfcPrimaryBrush}"
                      IsVisible="{Binding IsSignalsPageActive}" />
              <Viewbox Grid.Column="1" Width="18" Height="18">
                <Canvas Width="24" Height="24">
                  <shapes:Path Stroke="{StaticResource TfcMutedTextBrush}"
                               StrokeThickness="1.7"
                               Data="M 5 19 L 5 9 L 9 5 L 12 10 L 15 7 L 19 12 L 19 19" />
                  <shapes:Line StartPoint="5,19" EndPoint="19,19"
                               Stroke="{StaticResource TfcMutedTextBrush}" StrokeThickness="1.7" />
                </Canvas>
              </Viewbox>
              <Grid Grid.Column="2" ColumnDefinitions="*,Auto">
                <TextBlock Text="Signals" VerticalAlignment="Center" />
                <Border Grid.Column="1"
                        Background="{StaticResource TfcPrimaryBrush}"
                        CornerRadius="8"
                        MinWidth="18"
                        Height="18"
                        Padding="4,0"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        IsVisible="{Binding HasSignalUnread}">
                  <TextBlock Text="{Binding SignalUnreadLabel}"
                             FontSize="10"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource TfcPrimaryOnBrush}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Grid>
          </Button>

          <Button Command="{Binding NavigateCommand}"
                  CommandParameter="settings"
                  Classes="nav-button">
            <Grid ColumnDefinitions="3,Auto,*" ColumnSpacing="12">
              <Border Grid.ColumnSpan="3"
                      Background="{StaticResource TfcRaisedBrush}"
                      IsVisible="{Binding IsSettingsPageActive}" />
              <Border Background="{StaticResource TfcPrimaryBrush}"
                      IsVisible="{Binding IsSettingsPageActive}" />
              <Viewbox Grid.Column="1" Width="18" Height="18">
                <Canvas Width="24" Height="24">
                  <shapes:Ellipse Width="6" Height="6" Canvas.Left="9" Canvas.Top="9"
                                  Stroke="{StaticResource TfcMutedTextBrush}" StrokeThickness="1.7" />
                  <shapes:Path Stroke="{StaticResource TfcMutedTextBrush}"
                               StrokeThickness="1.6"
                               StrokeLineCap="Round"
                               Data="M 12 3 L 12 6 M 12 18 L 12 21 M 3 12 L 6 12 M 18 12 L 21 12 M 5.6 5.6 L 7.8 7.8 M 16.2 16.2 L 18.4 18.4 M 18.4 5.6 L 16.2 7.8 M 7.8 16.2 L 5.6 18.4" />
                </Canvas>
              </Viewbox>
              <TextBlock Grid.Column="2" Text="Settings" VerticalAlignment="Center" />
            </Grid>
          </Button>
        </StackPanel>
      </StackPanel>

      <Grid />
    </DockPanel>
  </Border>
</UserControl>
