<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.Components.TopHostsView"
             x:DataType="vm:OverviewPageViewModel"
             x:Name="Root">
  <Border Classes="tfc-panel" ClipToBounds="True">
    <Grid RowDefinitions="32,*">
      <Border Classes="tfc-panel-header" Padding="16,0">
        <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="Top Hosts by Packets" />
      </Border>
      <Grid Grid.Row="1">
        <TextBlock Classes="muted-text" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Text="No host data yet" IsVisible="{Binding HasNoTopHostRows}" />
        <ItemsControl Margin="10,8" ItemsSource="{Binding TopHostRows}" IsVisible="{Binding HasTopHostRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:OverviewMetricRowViewModel">
              <Button Classes="ranking-row"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Command="{Binding #Root.((vm:OverviewPageViewModel)DataContext).PivotRankingCommand}"
                      CommandParameter="{Binding}"
                      ToolTip.Tip="{Binding Tooltip}">
                <Grid ColumnDefinitions="1.4*,*,64" ColumnSpacing="10" Height="28">
                  <SelectableTextBlock Classes="tfc-data"
                                       Text="{Binding Label}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False" />
                  <Border Grid.Column="1" Height="6" Background="{StaticResource TfcDataTrackBrush}" VerticalAlignment="Center">
                    <Border Background="{Binding AccentBrush}" Width="{Binding BarWidth}" HorizontalAlignment="Left" />
                  </Border>
                  <SelectableTextBlock Grid.Column="2" Classes="tfc-data" Foreground="{StaticResource TfcMutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding ValueLabel}" IsHitTestVisible="False" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Grid>
  </Border>
</UserControl>
