<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.Components.TopHostsView"
             x:DataType="vm:OverviewPageViewModel">
  <Border Classes="glass-panel">
    <StackPanel Spacing="10">
      <TextBlock Classes="section-title" Text="Top Hosts" />
      <ItemsControl ItemsSource="{Binding Snapshot.TopHosts}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="status-pill" Margin="0,0,0,8" Padding="14,12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding Host}" />
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                  <TextBlock Text="{Binding Bytes}" HorizontalAlignment="Right" />
                  <TextBlock Classes="muted-text" Text="{Binding Packets, StringFormat={}{0} pkts}" HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
