<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.Components.SourcePreviewWorkbenchView"
             x:DataType="vm:SourcePageViewModel">
  <Border Classes="glass-panel">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="12">
      <TextBlock Classes="section-title" Text="Preview Workbench" />

      <StackPanel Grid.Row="1" Spacing="4">
        <SelectableTextBlock Text="{Binding SelectedDevice.DisplayName}" FontWeight="SemiBold" />
        <SelectableTextBlock Classes="muted-text" Text="Preview only. Formal capture still requires one explicit source selection." />
      </StackPanel>

      <Border Grid.Row="2"
              Background="#23293B"
              CornerRadius="14"
              Padding="14,12">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Border Background="{Binding SelectedDevice.StatusBackground}"
                  CornerRadius="999"
                  Padding="10,6">
            <SelectableTextBlock FontSize="12"
                                 FontWeight="SemiBold"
                                 Foreground="{Binding SelectedDevice.StatusForeground}"
                                 Text="{Binding PreviewStatusLabel}" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="4">
            <SelectableTextBlock FontWeight="SemiBold" Text="{Binding PreviewStatusLabel}" />
            <SelectableTextBlock Classes="muted-text" Text="{Binding PreviewStatusDetail}" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12">
        <Border Classes="status-pill">
          <StackPanel Spacing="4">
            <SelectableTextBlock Text="Packets Seen" />
            <SelectableTextBlock Text="{Binding SelectedDevice.Preview.PacketsSeen}" FontSize="20" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="status-pill">
          <StackPanel Spacing="4">
            <SelectableTextBlock Text="Bytes Seen" />
            <SelectableTextBlock Text="{Binding SelectedDevice.Preview.BytesSeen}" FontSize="20" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
      </Grid>

      <StackPanel Grid.Row="4" Spacing="8">
        <TextBlock Classes="section-title" Text="Selected Device Details" />
        <SelectableTextBlock Classes="muted-text" Text="{Binding SelectedDevice.ReadinessLabel}" />
        <ItemsControl ItemsSource="{Binding SelectedDevice.Device.Addresses}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="status-pill">
                <SelectableTextBlock Text="{Binding Address}" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      
    </Grid>
  </Border>
</UserControl>
