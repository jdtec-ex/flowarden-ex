<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.Components.SettingsCaptureDefaultsPanelView"
             x:DataType="vm:SettingsPageViewModel">
  <Border Classes="tfc-panel" Padding="14,12">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock Classes="section-title" Text="Capture Defaults" VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Classes="mode-button"
                Height="28"
                Padding="12,0"
                Content="Apply"
                Command="{Binding SaveWatchlistsCommand}" />
      </Grid>

      <!-- Top N + Threshold on one row -->
      <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
        <StackPanel Spacing="4">
          <TextBlock Classes="tfc-label" FontSize="11" Text="TOP N" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <TextBox Height="28"
                     Text="{Binding TopNInput, Mode=TwoWay}" />
            <Button Grid.Column="1"
                    Classes="tools-button"
                    Height="28"
                    Padding="10,0"
                    Content="Set"
                    Command="{Binding ApplyTopNCommand}" />
          </Grid>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Classes="tfc-label" FontSize="11" Text="DATA THRESHOLD (BYTES)" />
          <TextBox Height="28"
                   Text="{Binding DataThresholdInput, Mode=TwoWay}"
                   Watermark="50000000" />
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="2" Spacing="4">
        <TextBlock Classes="tfc-label" FontSize="11" Text="WATCHED (host, service:, process:, sni:)" />
        <TextBox Height="28"
                 Text="{Binding WatchedHostsInput, Mode=TwoWay}"
                 Watermark="1.1.1.1, service:https, process:Edge, sni:github.com" />
      </StackPanel>

      <StackPanel Grid.Row="3" Spacing="4">
        <TextBlock Classes="tfc-label" FontSize="11" Text="KNOWN-BAD (host, service:, process:, sni:)" />
        <TextBox Height="28"
                 Text="{Binding KnownBadHostsInput, Mode=TwoWay}"
                 Watermark="host, service:name, process:name" />
      </StackPanel>

      <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="10">
        <CheckBox Content="In-app toast"
                  FontSize="12"
                  IsChecked="{Binding DesktopNotificationsEnabled, Mode=TwoWay}" />
        <CheckBox Grid.Column="1"
                  Content="Alert sound"
                  FontSize="12"
                  IsChecked="{Binding SignalSoundEnabled, Mode=TwoWay}" />
      </Grid>

      <StackPanel Grid.Row="5" Spacing="4">
        <TextBlock Classes="tfc-label" FontSize="11" Text="UI DENSITY" />
        <CheckBox Content="Compact layout"
                  FontSize="12"
                  IsChecked="{Binding IsCompactDensity, Mode=TwoWay}"
                  ToolTip.Tip="Tighter table rows and workbench padding. Preference is saved with Apply / local prefs." />
        <TextBlock Classes="muted-text"
                   FontSize="11"
                   Text="{Binding DensityModeLabel, StringFormat=Mode: {0}}" />
      </StackPanel>

      <TextBlock Grid.Row="6"
                 Classes="muted-text"
                 FontSize="11"
                 Text="{Binding ListsStatus}"
                 TextWrapping="Wrap" />
    </Grid>
  </Border>
</UserControl>
