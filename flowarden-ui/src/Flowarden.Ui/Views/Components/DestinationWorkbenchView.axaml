<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.Components.DestinationWorkbenchView"
             x:DataType="vm:OverviewPageViewModel">
  <Grid RowDefinitions="*,Auto" RowSpacing="20">
    <Border Classes="glass-panel" MinHeight="260">
      <StackPanel Spacing="10">
        <TextBlock Classes="section-title" Text="Destination Map" />
        <Border Background="{StaticResource CosmosSurfaceHighBrush}" CornerRadius="12" Padding="16" MinHeight="180">
          <StackPanel Spacing="8" VerticalAlignment="Center">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Reserved Map Region" />
            <TextBlock Classes="muted-text" Text="{Binding DestinationPlaceholderMessage}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Classes="glass-panel">
      <StackPanel Spacing="10">
        <TextBlock Classes="section-title" Text="Top Destinations" />
        <ItemsControl ItemsSource="{Binding Snapshot.TopDestinations}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <TextBlock Text="{Binding Label}" />
                <TextBlock Grid.Column="1" Classes="muted-text" Text="{Binding Bytes}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
