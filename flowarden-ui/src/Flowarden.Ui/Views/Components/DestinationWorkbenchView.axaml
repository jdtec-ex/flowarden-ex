<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shapes="using:Avalonia.Controls.Shapes"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.Components.DestinationWorkbenchView"
             x:Name="Root"
             x:DataType="vm:OverviewPageViewModel">
  <Grid RowDefinitions="200,*" RowSpacing="16">
    <Border Classes="tfc-panel" ClipToBounds="True">
      <Grid RowDefinitions="32,*">
        <Border Classes="tfc-panel-header" Padding="16,0">
          <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="Geospatial Routing" />
        </Border>
        <Border Grid.Row="1" Margin="10" Background="{StaticResource TfcBackgroundBrush}" BorderBrush="{StaticResource TfcBorderBrush}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
          <Grid>
            <Viewbox Stretch="Uniform" Margin="8">
              <Canvas Width="360" Height="170">
                <shapes:Path Fill="{StaticResource TfcMapLandBrush}"
                             Stroke="{StaticResource TfcMapStrokeBrush}"
                             StrokeThickness="0.6"
                             Opacity="0.92"
                             Data="{Binding WorldMapPathData}" />
                <Grid DataContext="{Binding PrimaryRegionMarker}"
                      Width="{Binding Size}"
                      Height="{Binding Size}"
                      Canvas.Left="{Binding X}"
                      Canvas.Top="{Binding Y}">
                  <Ellipse Fill="{Binding AccentBrush}" Opacity="0.22" />
                  <Ellipse Margin="3" Fill="{Binding AccentBrush}" Stroke="{StaticResource TfcBackgroundBrush}" StrokeThickness="1" />
                </Grid>
                <Grid DataContext="{Binding SecondaryRegionMarker}"
                      Width="{Binding Size}"
                      Height="{Binding Size}"
                      Canvas.Left="{Binding X}"
                      Canvas.Top="{Binding Y}">
                  <Ellipse Fill="{Binding AccentBrush}" Opacity="0.22" />
                  <Ellipse Margin="3" Fill="{Binding AccentBrush}" Stroke="{StaticResource TfcBackgroundBrush}" StrokeThickness="1" />
                </Grid>
                <Grid DataContext="{Binding TertiaryRegionMarker}"
                      Width="{Binding Size}"
                      Height="{Binding Size}"
                      Canvas.Left="{Binding X}"
                      Canvas.Top="{Binding Y}">
                  <Ellipse Fill="{Binding AccentBrush}" Opacity="0.22" />
                  <Ellipse Margin="3" Fill="{Binding AccentBrush}" Stroke="{StaticResource TfcBackgroundBrush}" StrokeThickness="1" />
                </Grid>
              </Canvas>
            </Viewbox>
            <StackPanel VerticalAlignment="Bottom" Margin="14" Spacing="4">
              <TextBlock Classes="tfc-label" Text="REGION MARKERS" />
              <TextBlock Classes="muted-text" FontSize="12" Text="Top destination regions from resolved public traffic" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="1" Classes="tfc-panel" ClipToBounds="True">
      <Grid RowDefinitions="32,*">
        <Border Classes="tfc-panel-header" Padding="16,0">
          <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="Top Regions" />
        </Border>
        <Grid Grid.Row="1">
          <TextBlock Classes="muted-text" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Text="No region data yet" IsVisible="{Binding HasNoTopRegionRows}" />
          <ItemsControl Margin="10,8" ItemsSource="{Binding TopRegionRows}" IsVisible="{Binding HasTopRegionRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:OverviewRegionRowViewModel">
                <Border Height="32" BorderBrush="{StaticResource TfcBorderBrush}" BorderThickness="0,0,0,1" Padding="2,0">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <SelectableTextBlock Classes="tfc-data" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <SelectableTextBlock Grid.Column="1"
                                         Classes="tfc-data"
                                         Foreground="{Binding AccentBrush}"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"
                                         Text="{Binding RatioLabel}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
