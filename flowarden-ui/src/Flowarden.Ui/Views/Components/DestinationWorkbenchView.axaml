<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shapes="using:Avalonia.Controls.Shapes"
             xmlns:components="using:Flowarden.Ui.Views.Components"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.Components.DestinationWorkbenchView"
             x:Name="Root"
             x:DataType="vm:OverviewPageViewModel">
  <Grid RowDefinitions="220,*" RowSpacing="16">
    <Border Classes="tfc-panel" ClipToBounds="True">
      <Grid RowDefinitions="32,*,Auto">
        <Border Classes="tfc-panel-header" Padding="16,0">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="Destination Map" />
            <TextBlock Grid.Column="1"
                       Classes="tfc-label"
                       VerticalAlignment="Center"
                       Text="COUNTRY · PUBLIC" />
          </Grid>
        </Border>
        <Border Grid.Row="1" Margin="10,8,10,4" Background="{StaticResource TfcBackgroundBrush}" BorderBrush="{StaticResource TfcBorderBrush}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
          <Grid>
            <Viewbox Stretch="Uniform" Margin="8">
              <Canvas Width="360" Height="170">
                <shapes:Path Fill="{StaticResource TfcMapLandBrush}"
                             Stroke="{StaticResource TfcMapStrokeBrush}"
                             StrokeThickness="0.6"
                             Opacity="0.92"
                             Data="{Binding WorldMapPathData}" />
                <Grid DataContext="{Binding PrimaryRegionMarker}"
                      Width="{Binding Size}"
                      Height="{Binding Size}"
                      Canvas.Left="{Binding X}"
                      Canvas.Top="{Binding Y}"
                      IsVisible="{Binding #Root.((vm:OverviewPageViewModel)DataContext).HasPrimaryRegionMarker}">
                  <Button Classes="map-marker"
                          Command="{Binding #Root.((vm:OverviewPageViewModel)DataContext).PivotRankingCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="{Binding MapTooltip}">
                    <Panel>
                      <Ellipse Fill="{Binding AccentBrush}" Opacity="0.22" Width="{Binding Size}" Height="{Binding Size}" />
                      <Ellipse Margin="3" Fill="{Binding AccentBrush}" Stroke="{StaticResource TfcBackgroundBrush}" StrokeThickness="1" />
                    </Panel>
                  </Button>
                </Grid>
                <Grid DataContext="{Binding SecondaryRegionMarker}"
                      Width="{Binding Size}"
                      Height="{Binding Size}"
                      Canvas.Left="{Binding X}"
                      Canvas.Top="{Binding Y}"
                      IsVisible="{Binding #Root.((vm:OverviewPageViewModel)DataContext).HasSecondaryRegionMarker}">
                  <Button Classes="map-marker"
                          Command="{Binding #Root.((vm:OverviewPageViewModel)DataContext).PivotRankingCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="{Binding MapTooltip}">
                    <Panel>
                      <Ellipse Fill="{Binding AccentBrush}" Opacity="0.22" Width="{Binding Size}" Height="{Binding Size}" />
                      <Ellipse Margin="3" Fill="{Binding AccentBrush}" Stroke="{StaticResource TfcBackgroundBrush}" StrokeThickness="1" />
                    </Panel>
                  </Button>
                </Grid>
                <Grid DataContext="{Binding TertiaryRegionMarker}"
                      Width="{Binding Size}"
                      Height="{Binding Size}"
                      Canvas.Left="{Binding X}"
                      Canvas.Top="{Binding Y}"
                      IsVisible="{Binding #Root.((vm:OverviewPageViewModel)DataContext).HasTertiaryRegionMarker}">
                  <Button Classes="map-marker"
                          Command="{Binding #Root.((vm:OverviewPageViewModel)DataContext).PivotRankingCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="{Binding MapTooltip}">
                    <Panel>
                      <Ellipse Fill="{Binding AccentBrush}" Opacity="0.22" Width="{Binding Size}" Height="{Binding Size}" />
                      <Ellipse Margin="3" Fill="{Binding AccentBrush}" Stroke="{StaticResource TfcBackgroundBrush}" StrokeThickness="1" />
                    </Panel>
                  </Button>
                </Grid>
              </Canvas>
            </Viewbox>
            <TextBlock VerticalAlignment="Bottom"
                       Margin="12,0,12,8"
                       Classes="muted-text"
                       FontSize="12"
                       Foreground="{StaticResource TfcDimTextBrush}"
                       Text="{Binding DestinationNarrativeSummary}"
                       TextWrapping="Wrap" />
          </Grid>
        </Border>
        <ItemsControl Grid.Row="2"
                      Margin="12,0,12,10"
                      ItemsSource="{Binding DestinationLegendMarkers}"
                      IsVisible="{Binding HasDestinationLegend}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:OverviewRegionMarkerViewModel">
              <Button Classes="region-legend-chip"
                      Command="{Binding #Root.((vm:OverviewPageViewModel)DataContext).PivotRankingCommand}"
                      CommandParameter="{Binding}"
                      ToolTip.Tip="{Binding MapTooltip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="tfc-data" FontSize="11" Text="{Binding ShortLabel}" />
                  <TextBlock Classes="muted-text" FontSize="11" Foreground="{StaticResource TfcDimTextBrush}" Text="{Binding RatioLabel}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>

    <Border Grid.Row="1" Classes="tfc-panel" ClipToBounds="True">
      <Grid RowDefinitions="32,*">
        <Border Classes="tfc-panel-header" Padding="16,0">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="Top Regions" />
            <TextBlock Grid.Column="1" Classes="tfc-label" VerticalAlignment="Center" Text="SHARE" />
          </Grid>
        </Border>
        <Grid Grid.Row="1">
          <components:EmptyStateView IsVisible="{Binding HasNoTopRegionRows}"
                                     Title="No region data yet"
                                     Detail="Public destination countries appear here once projection resolves outbound traffic." />
          <ItemsControl Margin="10,8" ItemsSource="{Binding TopRegionRows}" IsVisible="{Binding HasTopRegionRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:OverviewRegionRowViewModel">
                <Button Classes="ranking-row"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Command="{Binding #Root.((vm:OverviewPageViewModel)DataContext).PivotRankingCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{Binding PivotTooltip}">
                  <Grid ColumnDefinitions="Auto,*,48,52" ColumnSpacing="8" Height="28">
                    <Border Width="7" Height="7" Background="{Binding AccentBrush}" VerticalAlignment="Center" />
                    <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="6" VerticalAlignment="Center">
                      <TextBlock Classes="tfc-data" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                      <Border Grid.Column="1" Height="5" Background="{StaticResource TfcDataTrackBrush}" VerticalAlignment="Center">
                        <Border Background="{Binding AccentBrush}" Width="{Binding BarWidth}" HorizontalAlignment="Left" />
                      </Border>
                    </Grid>
                    <TextBlock Grid.Column="2"
                               Classes="tfc-data"
                               FontSize="12"
                               Foreground="{StaticResource TfcDimTextBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{Binding RatioLabel}" />
                    <TextBlock Grid.Column="3"
                               Classes="muted-text"
                               FontSize="11"
                               Foreground="{StaticResource TfcDimTextBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{Binding BytesLabel}" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
