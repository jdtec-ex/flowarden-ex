<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.Components.DestinationWorkbenchView"
             x:DataType="vm:OverviewPageViewModel">
  <Grid RowDefinitions="*,Auto" RowSpacing="20">
    <Border Classes="glass-panel" MinHeight="260">
      <StackPanel Spacing="10">
        <TextBlock Classes="section-title" Text="Destination Map" />
        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
          <Border Classes="status-pill">
            <TextBlock Text="{Binding SourceSummary}" />
          </Border>
          <Border Grid.Column="1" Classes="status-pill">
            <TextBlock Text="Reserved panel" />
          </Border>
        </Grid>
        <Border Background="{StaticResource CosmosSurfaceHighBrush}" CornerRadius="12" Padding="16" MinHeight="180">
          <StackPanel Spacing="10" VerticalAlignment="Center">
            <Border Classes="status-pill">
              <TextBlock Text="{Binding DestinationPlaceholderState}" />
            </Border>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding DestinationPlaceholderTitle}" />
            <TextBlock Classes="muted-text" Text="{Binding DestinationPlaceholderMessage}" TextWrapping="Wrap" />
            <TextBlock Classes="muted-text" Text="{Binding DestinationPlaceholderHint}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Classes="glass-panel">
      <StackPanel Spacing="10">
        <TextBlock Classes="section-title" Text="Top Destinations" />
        <ItemsControl ItemsSource="{Binding Snapshot.TopDestinations}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="status-pill" Margin="0,0,0,8" Padding="14,12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <StackPanel Spacing="4">
                    <SelectableTextBlock Text="{Binding Label}" />
                    <SelectableTextBlock Classes="muted-text"
                                         Text="{Binding Ratio, StringFormat=ratio {0:P0}}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="4">
                    <SelectableTextBlock Text="{Binding Bytes}" HorizontalAlignment="Right" />
                    <SelectableTextBlock Classes="muted-text"
                                         Text="{Binding CountryLabel}"
                                         HorizontalAlignment="Right" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="muted-text"
                   Text="Destination ranking is already stable; the map panel is reserved for the future spatial projection of the same destination data." />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
