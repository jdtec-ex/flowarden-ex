<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.Components.InspectFooterSummaryView"
             x:DataType="vm:InspectPageViewModel">
  <Border Background="{StaticResource TfcRaisedBrush}"
          BorderBrush="{StaticResource TfcBorderBrush}"
          BorderThickness="1,0,1,1"
          CornerRadius="0,0,6,6"
          Padding="14,0">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="18" Height="32">
      <TextBlock Classes="muted-text" FontSize="13" VerticalAlignment="Center" Text="{Binding ActiveFilterSummary}" />
      <TextBlock Grid.Column="1" Classes="tfc-data" FontSize="12" VerticalAlignment="Center" Text="{Binding ResultCountLabel}" />
      <TextBlock Grid.Column="2" Classes="tfc-data" FontSize="12" VerticalAlignment="Center" Text="{Binding TotalBytesLabel}" />
      <TextBlock Grid.Column="3" Classes="tfc-data" FontSize="12" VerticalAlignment="Center" Text="{Binding TotalPacketsLabel}" />
    </Grid>
  </Border>
</UserControl>
