<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.Components.InspectHeaderView"
             x:DataType="vm:InspectPageViewModel">
  <Border Classes="glass-panel">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
      <StackPanel>
        <TextBlock Classes="section-title" Text="Inspect" />
        <TextBlock Classes="muted-text" Text="{Binding ActiveFilterSummary}" TextWrapping="Wrap" />
      </StackPanel>
      <Border Grid.Column="1" Classes="status-pill">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="{Binding ResultCountLabel}" />
          <TextBlock Classes="muted-text" Text="{Binding ProjectionStateLabel}" />
        </StackPanel>
      </Border>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Button Classes="mode-button"
                Command="{Binding SwitchToFlowsCommand}"
                Content="{Binding FlowModeLabel}" />
        <Button Classes="mode-button"
                Command="{Binding SwitchToTcpConnectionsCommand}"
                Content="{Binding TcpConnectionsModeLabel}" />
      </StackPanel>
      <Button Grid.Column="3"
              Classes="tools-button"
              Command="{Binding ClearFiltersCommand}"
              Content="Clear All" />
    </Grid>
  </Border>
</UserControl>
