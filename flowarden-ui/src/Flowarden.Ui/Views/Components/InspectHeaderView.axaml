<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.Components.InspectHeaderView"
             x:DataType="vm:InspectPageViewModel">
  <Border Classes="tfc-panel" Padding="14">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
      <StackPanel>
        <TextBlock Classes="section-title" Text="Inspect" />
        <TextBlock Classes="muted-text"
                   FontSize="13"
                   Text="{Binding ActiveFilterSummary}"
                   TextWrapping="Wrap" />
      </StackPanel>
      <Border Grid.Column="1"
              Classes="status-pill"
              VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="{Binding ResultCountLabel}" />
          <TextBlock Classes="muted-text" Text="{Binding ProjectionStateLabel}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2"
              Background="{StaticResource TfcPanelLowBrush}"
              BorderBrush="{StaticResource TfcBorderBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="3"
              VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Background="{Binding FlowModeBackground}"
                  BorderBrush="{Binding FlowModeBorderBrush}"
                  BorderThickness="1"
                  Foreground="{Binding FlowModeForeground}"
                  MinWidth="72"
                  Padding="10,5"
                  Command="{Binding SwitchToFlowsCommand}"
                  Content="{Binding FlowModeLabel}" />
          <Button Background="{Binding TcpModeBackground}"
                  BorderBrush="{Binding TcpModeBorderBrush}"
                  BorderThickness="1"
                  Foreground="{Binding TcpModeForeground}"
                  MinWidth="136"
                  Padding="10,5"
                  Command="{Binding SwitchToTcpConnectionsCommand}"
                  Content="{Binding TcpConnectionsModeLabel}" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
