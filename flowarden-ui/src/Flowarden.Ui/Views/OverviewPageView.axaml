<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="using:Flowarden.Ui.Views.Components"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.OverviewPageView"
             x:DataType="vm:OverviewPageViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <Grid RowDefinitions="Auto,Auto" RowSpacing="16">
      <Grid ColumnDefinitions="1.75*,1.1*" ColumnSpacing="16">
        <components:HeroTrafficChartView DataContext="{Binding}" />
        <components:DestinationWorkbenchView Grid.Column="1" DataContext="{Binding}" />
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="16">
        <components:TopHostsView DataContext="{Binding}" />
        <components:TopServicesView Grid.Column="1" DataContext="{Binding}" />
        <components:TopConnectionsView Grid.Column="2" DataContext="{Binding}" />
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
