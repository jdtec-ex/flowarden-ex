<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="using:Flowarden.Ui.Views.Components"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.OverviewPageView"
             x:DataType="vm:OverviewPageViewModel">
  <Grid ColumnDefinitions="2*,*" RowDefinitions="Auto,Auto,*" ColumnSpacing="20" RowSpacing="20">
    <components:HeroTrafficChartView Grid.ColumnSpan="2" DataContext="{Binding}" />
    <components:StatusCardsRowView Grid.Row="1" DataContext="{Binding}" />
    <components:DestinationWorkbenchView Grid.Row="1" Grid.Column="1" Grid.RowSpan="2" DataContext="{Binding}" />

    <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="20">
      <components:TopHostsView DataContext="{Binding}" />
      <components:TopServicesView Grid.Column="1" DataContext="{Binding}" />
      <components:TopConnectionsView Grid.Column="2" DataContext="{Binding}" />
    </Grid>
  </Grid>
</UserControl>
