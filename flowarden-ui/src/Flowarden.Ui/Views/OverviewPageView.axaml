<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="using:Flowarden.Ui.Views.Components"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.OverviewPageView"
             x:DataType="vm:OverviewPageViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <Grid RowDefinitions="72,400,300" RowSpacing="16">
      <Grid Height="72" ColumnDefinitions="2*,2*,2*,3*,3*" ColumnSpacing="16">
        <Border Classes="tfc-panel" Padding="14,10">
          <StackPanel>
            <TextBlock Classes="tfc-label" Text="PACKETS" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="tfc-data" FontSize="20" FontWeight="SemiBold" Text="{Binding PacketsLabel}" />
              <TextBlock Classes="tfc-label" Foreground="{StaticResource TfcGoodBrush}" VerticalAlignment="Bottom" Text="{Binding PacketsHealthLabel}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="tfc-panel" Padding="14,10">
          <StackPanel>
            <TextBlock Classes="tfc-label" Text="BYTES" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="tfc-data" FontSize="20" FontWeight="SemiBold" Text="{Binding BytesLabel}" />
              <TextBlock Classes="tfc-label" Foreground="{StaticResource TfcGoodBrush}" VerticalAlignment="Bottom" Text="{Binding BytesHealthLabel}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="tfc-panel" Padding="14,10">
          <StackPanel>
            <TextBlock Classes="tfc-label" Text="ACTIVE SOURCE" />
            <TextBlock Classes="tfc-data" Foreground="{StaticResource TfcTrafficCyanBrush}" Text="{Binding ActiveSourceLabel}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="3" Classes="tfc-panel" Padding="14,10">
          <StackPanel>
            <TextBlock Classes="tfc-label" Text="TOP HOST" />
            <TextBlock Classes="tfc-data" Text="{Binding TopHostLabel}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="4" Classes="tfc-panel" Padding="14,10">
          <StackPanel>
            <TextBlock Classes="tfc-label" Text="TOP SERVICE" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Width="8" Height="8" Background="{StaticResource TfcTrafficPurpleBrush}" VerticalAlignment="Center" />
              <TextBlock Classes="tfc-data" Text="{Binding TopServiceDisplayLabel}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="8*,4*" ColumnSpacing="16">
        <components:HeroTrafficChartView DataContext="{Binding}" />
        <components:DestinationWorkbenchView Grid.Column="1" DataContext="{Binding}" />
      </Grid>

      <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="16">
        <components:TopHostsView DataContext="{Binding}" />
        <components:TopServicesView Grid.Column="1" DataContext="{Binding}" />
        <components:TopConnectionsView Grid.Column="2" DataContext="{Binding}" />
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
