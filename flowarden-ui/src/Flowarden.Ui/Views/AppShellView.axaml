<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="using:Flowarden.Ui.Views.Components"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.AppShellView"
             x:DataType="vm:AppShellViewModel">
  <Grid ColumnDefinitions="260,*">
    <components:AppRailView />

    <Border Grid.Column="1"
            Background="{StaticResource CosmosBackgroundBrush}"
            Padding="24">
      <Grid RowDefinitions="Auto,*" RowSpacing="20">
        <components:AppHeaderView />

        <Border Grid.Row="1"
                Classes="glass-panel main-workbench">
          <Grid RowDefinitions="Auto,*" RowSpacing="16">
            <TextBlock Classes="section-title" Text="{Binding CurrentPage.Title}" />

            <Grid Grid.Row="1">
              <Border IsVisible="{Binding IsSourcePageActive}" Classes="workbench-placeholder">
                <StackPanel Spacing="8">
                  <TextBlock Classes="section-title" Text="Source Workbench" />
                  <TextBlock Classes="muted-text"
                             Text="Source selection, preview summaries and session launch controls will land in M2-005." />
                </StackPanel>
              </Border>

              <Grid IsVisible="{Binding IsOverviewPageActive}"
                    ColumnDefinitions="2*,*"
                    RowDefinitions="Auto,Auto,*"
                    ColumnSpacing="20"
                    RowSpacing="20">
                <Border Classes="glass-panel" Grid.ColumnSpan="2" MinHeight="220">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="section-title" Text="Hero Traffic Chart" />
                    <TextBlock Classes="muted-text"
                               Text="Traffic trend host panel reserved for Overview implementation." />
                  </StackPanel>
                </Border>

                <Border Classes="glass-panel" Grid.Row="1" MinHeight="120">
                  <TextBlock Classes="section-title" Text="Status Cards Row" />
                </Border>

                <Border Classes="glass-panel" Grid.Row="1" Grid.Column="1" MinHeight="120">
                  <TextBlock Classes="section-title" Text="Top Destinations" />
                </Border>

                <Border Classes="glass-panel" Grid.Row="2" MinHeight="260">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="section-title" Text="Destination Map" />
                    <TextBlock Classes="muted-text"
                               Text="Reserved panel required by phase 2 MVP." />
                  </StackPanel>
                </Border>

                <Border Classes="glass-panel" Grid.Row="2" Grid.Column="1" MinHeight="260">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="section-title" Text="Lower Detail Row" />
                    <TextBlock Classes="muted-text"
                               Text="Top hosts / top services / top connections placeholder." />
                  </StackPanel>
                </Border>
              </Grid>

              <Border IsVisible="{Binding IsInspectPageActive}" Classes="workbench-placeholder">
                <StackPanel Spacing="8">
                  <TextBlock Classes="section-title" Text="Inspect Workbench" />
                  <TextBlock Classes="muted-text"
                             Text="Filter bar, results table and footer summary will land in M2-007." />
                </StackPanel>
              </Border>

              <Border IsVisible="{Binding IsSettingsPageActive}" Classes="workbench-placeholder">
                <StackPanel Spacing="8">
                  <TextBlock Classes="section-title" Text="Settings Workbench" />
                  <TextBlock Classes="muted-text"
                             Text="Runtime endpoint, current source, BPF and diagnostics will land in M2-008." />
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
