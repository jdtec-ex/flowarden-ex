<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.AppShellView"
             x:DataType="vm:AppShellViewModel">
  <Grid ColumnDefinitions="240,*">
    <Border Background="{StaticResource CosmosSurfaceBrush}" Padding="20">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Spacing="24">
          <StackPanel Spacing="4">
            <TextBlock Classes="page-title" Text="{Binding Title}" />
            <TextBlock Foreground="{StaticResource CosmosMutedTextBrush}"
                       Text="{Binding Subtitle}" />
          </StackPanel>

          <StackPanel Spacing="8">
            <Button HorizontalAlignment="Stretch" Content="Source" />
            <Button HorizontalAlignment="Stretch" Content="Overview" />
            <Button HorizontalAlignment="Stretch" Content="Inspect" />
            <Button HorizontalAlignment="Stretch" Content="Settings" />
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="12">
          <Button HorizontalAlignment="Stretch" Content="Start Capture" />
          <Button HorizontalAlignment="Stretch" Content="Docs" />
          <Button HorizontalAlignment="Stretch" Content="Quit" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Grid.Column="1"
            Background="{StaticResource CosmosBackgroundBrush}"
            Padding="20">
      <Grid RowDefinitions="Auto,*" RowSpacing="20">
        <Border Classes="glass-panel" Grid.Row="0">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
            <StackPanel>
              <TextBlock Classes="page-title" Text="{Binding CurrentPageTitle}" />
              <TextBlock Foreground="{StaticResource CosmosMutedTextBrush}"
                         Text="{Binding CurrentMode}" />
            </StackPanel>

            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Text="{Binding CoreStatus}" />
            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       Text="{Binding CaptureStatus}" />
          </Grid>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="2*,*"
              RowDefinitions="Auto,Auto,*"
              ColumnSpacing="20"
              RowSpacing="20">
          <Border Classes="glass-panel" Grid.ColumnSpan="2" MinHeight="220">
            <StackPanel Spacing="8">
              <TextBlock Classes="section-title" Text="Hero Traffic Chart" />
              <TextBlock Foreground="{StaticResource CosmosMutedTextBrush}"
                         Text="Phase 2 shell placeholder for Overview hero chart." />
            </StackPanel>
          </Border>

          <Border Classes="glass-panel" Grid.Row="1" MinHeight="120">
            <TextBlock Classes="section-title" Text="Status Cards Row" />
          </Border>

          <Border Classes="glass-panel" Grid.Row="1" Grid.Column="1" MinHeight="120">
            <TextBlock Classes="section-title" Text="Top Destinations" />
          </Border>

          <Border Classes="glass-panel" Grid.Row="2" MinHeight="260">
            <StackPanel Spacing="8">
              <TextBlock Classes="section-title" Text="Destination Map" />
              <TextBlock Foreground="{StaticResource CosmosMutedTextBrush}"
                         Text="Reserved panel required by phase 2 MVP." />
            </StackPanel>
          </Border>

          <Border Classes="glass-panel" Grid.Row="2" Grid.Column="1" MinHeight="260">
            <StackPanel Spacing="8">
              <TextBlock Classes="section-title" Text="Lower Detail Row" />
              <TextBlock Foreground="{StaticResource CosmosMutedTextBrush}"
                         Text="Top hosts / top services / top connections placeholder." />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
