<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="using:Flowarden.Ui.Views.Components"
             xmlns:views="using:Flowarden.Ui.Views"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Name="ShellRoot"
             x:Class="Flowarden.Ui.Views.AppShellView"
             x:DataType="vm:AppShellViewModel">
  <Grid ColumnDefinitions="260,*">
    <components:AppRailView />

    <Border Grid.Column="1"
            Background="{StaticResource CosmosBackgroundBrush}"
            Padding="24">
      <Grid RowDefinitions="Auto,*" RowSpacing="20">
        <components:AppHeaderView />

        <Border Grid.Row="1"
                Classes="glass-panel main-workbench">
          <Grid RowDefinitions="Auto,*" RowSpacing="16">
            <TextBlock Classes="section-title" Text="{Binding CurrentPage.Title}" />

            <Grid Grid.Row="1">
              <views:SourcePageView DataContext="{Binding SourcePage}"
                                    IsVisible="{Binding DataContext.IsSourcePageActive, ElementName=ShellRoot}" />

              <views:OverviewPageView DataContext="{Binding OverviewPage}"
                                      IsVisible="{Binding DataContext.IsOverviewPageActive, ElementName=ShellRoot}" />

              <views:InspectPageView DataContext="{Binding InspectPage}"
                                     IsVisible="{Binding DataContext.IsInspectPageActive, ElementName=ShellRoot}" />

              <views:SettingsPageView DataContext="{Binding SettingsPage}"
                                      IsVisible="{Binding DataContext.IsSettingsPageActive, ElementName=ShellRoot}" />
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
