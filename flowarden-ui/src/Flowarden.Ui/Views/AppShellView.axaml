<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="using:Flowarden.Ui.Views.Components"
             xmlns:views="using:Flowarden.Ui.Views"
             xmlns:vm="using:Flowarden.Ui.ViewModels"
             x:Class="Flowarden.Ui.Views.AppShellView"
             x:DataType="vm:AppShellViewModel">
  <Grid ColumnDefinitions="260,*">
    <components:AppRailView />

    <Border Grid.Column="1"
            Background="{StaticResource CosmosBackgroundBrush}"
            Padding="24">
      <Grid RowDefinitions="Auto,*" RowSpacing="20">
        <components:AppHeaderView />

        <Border Grid.Row="1"
                Classes="glass-panel main-workbench">
          <Grid RowDefinitions="Auto,*" RowSpacing="16">
            <TextBlock Classes="section-title" Text="{Binding CurrentPage.Title}" />

            <Grid Grid.Row="1">
              <views:SourcePageView IsVisible="{Binding IsSourcePageActive}" />

              <views:OverviewPageView IsVisible="{Binding IsOverviewPageActive}" />

              <Border IsVisible="{Binding IsInspectPageActive}" Classes="workbench-placeholder">
                <StackPanel Spacing="8">
                  <TextBlock Classes="section-title" Text="Inspect Workbench" />
                  <TextBlock Classes="muted-text"
                             Text="Filter bar, results table and footer summary will land in M2-007." />
                </StackPanel>
              </Border>

              <Border IsVisible="{Binding IsSettingsPageActive}" Classes="workbench-placeholder">
                <StackPanel Spacing="8">
                  <TextBlock Classes="section-title" Text="Settings Workbench" />
                  <TextBlock Classes="muted-text"
                             Text="Runtime endpoint, current source, BPF and diagnostics will land in M2-008." />
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
