<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource TfcBackgroundBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TfcTextBrush}" />
    <Setter Property="FontFamily" Value="Geist, Segoe UI, Helvetica Neue, Arial" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TfcTextBrush}" />
  </Style>

  <Style Selector="TextBlock.muted-text">
    <Setter Property="Foreground" Value="{StaticResource TfcDimTextBrush}" />
  </Style>

  <Style Selector="SelectableTextBlock.muted-text">
    <Setter Property="Foreground" Value="{StaticResource TfcDimTextBrush}" />
  </Style>

  <Style Selector="TextBlock.page-title">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="32" />
  </Style>

  <Style Selector="TextBlock.section-title">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="24" />
  </Style>

  <Style Selector="TextBlock.tfc-label">
    <Setter Property="Foreground" Value="{StaticResource TfcMutedTextBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.tfc-data">
    <Setter Property="FontFamily" Value="JetBrains Mono, Menlo, Consolas, monospace" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="SelectableTextBlock.tfc-data">
    <Setter Property="FontFamily" Value="JetBrains Mono, Menlo, Consolas, monospace" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="Border.tfc-panel">
    <Setter Property="Background" Value="{StaticResource TfcPanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource TfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <Style Selector="Border.tfc-panel-low">
    <Setter Property="Background" Value="{StaticResource TfcPanelLowBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource TfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector="Border.tfc-panel-header">
    <Setter Property="Background" Value="{StaticResource TfcRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource TfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="16,10" />
  </Style>

  <Style Selector="Border.glass-panel">
    <Setter Property="Background" Value="{StaticResource TfcPanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource TfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style Selector="Border.app-rail">
    <Setter Property="Background" Value="{StaticResource TfcShellBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource TfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Padding" Value="20,24" />
  </Style>

  <Style Selector="Border.app-header">
    <Setter Property="Background" Value="{StaticResource TfcShellBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource TfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="24,0" />
  </Style>

  <Style Selector="Border.main-workbench">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="24" />
  </Style>

  <Style Selector="Border.workbench-placeholder">
    <Setter Property="Background" Value="{StaticResource TfcPanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource TfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="MinHeight" Value="420" />
  </Style>

  <Style Selector="Button">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.nav-button">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TfcMutedTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="16,12" />
  </Style>

  <Style Selector="Button.rail-button">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TfcMutedTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <Style Selector="Button.primary-cta">
    <Setter Property="Background" Value="{StaticResource TfcPrimaryBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TfcPrimaryOnBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource TfcPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button.mode-button">
    <Setter Property="Background" Value="{StaticResource TfcPrimaryBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TfcPrimaryOnBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource TfcPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button.tools-button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TfcTextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource TfcBorderHighBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button.danger-button">
    <Setter Property="Background" Value="{StaticResource TfcPanelLowBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TfcErrorBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource TfcBorderHighBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button.source-device-item">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{StaticResource TfcPanelBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TfcTextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource TfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="Margin" Value="0" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Background" Value="{StaticResource TfcPanelLowBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TfcTextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource TfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <Style Selector="ToggleSwitch">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="Border.status-pill">
    <Setter Property="Background" Value="{StaticResource TfcRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource TfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,5" />
  </Style>

  <Style Selector="Border.status-pill-good">
    <Setter Property="Background" Value="{StaticResource TfcPanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource TfcGoodBrush}" />
  </Style>

  <Style Selector="Border.tfc-chip">
    <Setter Property="Background" Value="{StaticResource TfcRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource TfcBorderHighBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <Style Selector="Border.tfc-table-header">
    <Setter Property="Background" Value="{StaticResource TfcRaisedHighBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource TfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,8" />
  </Style>

  <Style Selector="Border.tfc-table-row">
    <Setter Property="Background" Value="{StaticResource TfcPanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource TfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
</Styles>
