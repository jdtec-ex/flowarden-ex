<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Flowarden.Ui.App"
             xmlns:local="using:Flowarden.Ui"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <StreamGeometry x:Key="IconRefresh">M17.65,6.35C16.2,4.9 14.21,4 12,4C7.58,4 4.01,7.58 4.01,12C4.01,16.42 7.58,20 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18C8.69,18 6,15.31 6,12C6,8.69 8.69,6 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4Z</StreamGeometry>
            <StreamGeometry x:Key="IconGridSquare">M3,3H10.5V10.5H3ZM13.5,3H21V10.5H13.5ZM3,13.5H10.5V21H3ZM13.5,13.5H21V21H13.5Z</StreamGeometry>
            <StreamGeometry x:Key="IconGridView">M3,4H21V8H3ZM3,10H21V14H3ZM3,16H21V20H3Z</StreamGeometry>
            <!-- Picture-in-picture: outer frame + inset panel (thumbnail monitor). -->
            <StreamGeometry x:Key="IconThumbnail">M3,5 L21,5 L21,19 L3,19 Z M13,12 L20,12 L20,18 L13,18 Z</StreamGeometry>
        </ResourceDictionary>
    </Application.Resources>
  
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Styles/Theme.axaml" />
        <StyleInclude Source="/Styles/Controls.axaml" />
    </Application.Styles>
</Application>
